  "$comment_exact": "Palabra completa, comparada en minusculas. Primera coincidencia gana; el orden de este objeto es el orden de registro del original.",
  "exact": {
    "basicTypes": ["str", "int", "dec", "bool", "string", "integer", "decimal", "double", "boolean"],
    "textSearch": ["startswith", "endswith", "instr", "instrrev", "indexof", "contains", "containskey", "count", "length", "len", "getlength"],
    "stringManipulation": ["trim", "trimend", "trimstart", "mid", "substring", "split", "replace"],
